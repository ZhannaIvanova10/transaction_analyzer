# API ключи для получения курсов валют и данных об акциях
# Получите ключи на соответствующих сервисах

# Для курсов валют (например, exchangerate-api.com)
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here
EXCHANGE_RATE_BASE_URL=https://api.exchangerate-api.com/v4/latest

# Для данных об акциях (например, Alpha Vantage)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# Альтернативный источник (Finnhub)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Настройки приложения
EXCEL_FILE_PATH=data/operations.xlsx
LOG_LEVEL=INFO
